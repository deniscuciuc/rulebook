root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

csharp_new_line_before_open_brace = all
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

[*.{csproj,props,targets,sln,yml,yaml,json,md}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# --- Analyzers -------------------------------------------------------------
[*.cs]
# IDE0160: the codebase uses file-scoped namespaces throughout.
csharp_style_namespace_declarations = file_scoped:warning

# A library must not capture the caller's SynchronizationContext: an app with one
# (WPF, WinForms, legacy ASP.NET) can otherwise deadlock evaluating a decision.
dotnet_diagnostic.CA2007.severity = warning
# Public entry points validate their arguments rather than surfacing a
# NullReferenceException from deep inside the evaluator.
dotnet_diagnostic.CA1062.severity = warning
# Anything that owns a disposable must release it.
dotnet_diagnostic.CA1001.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA1063.severity = warning
# Rule evaluation must not depend on the machine's locale: a decimal comma would change
# which side of a numeric threshold a value falls on.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1310.severity = warning

[src/**/*.cs]
# CA1848 wants LoggerMessage source generators. A decision evaluation logs at most once
# per call and the engine is not on a hot logging path.
dotnet_diagnostic.CA1848.severity = suggestion

[{tests,examples}/**/*.cs]
# xUnit method names are Method_Should_When, which CA1707 objects to.
dotnet_diagnostic.CA1707.severity = none
# Top-level programs and test fixtures do not need namespaces.
dotnet_diagnostic.CA1050.severity = none
# Test code is not a shipped API surface.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1711.severity = none
# CA1861 wants inline constant arrays hoisted to static readonly fields. In a test that
# builds its expected values next to the assertion, inlining is the clearer form.
dotnet_diagnostic.CA1861.severity = none
# CA2012 fires on NSubstitute's setup idiom — mock.ValueTaskMethod(...).Returns(...) reads
# as "consuming" a ValueTask, but nothing is awaited and no instance is reused.
dotnet_diagnostic.CA2012.severity = none
# BenchmarkDotNet discovers [Benchmark] methods on an instance; CA1822's advice to make
# them static is noise here.
dotnet_diagnostic.CA1822.severity = none
